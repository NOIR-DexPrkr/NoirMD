{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "*.tsx",
    "core/**/*.ts",
    "react/**/*.ts",
    "react/**/*.tsx",
    "react/*.ts",
    "vanilla/**/*.ts",
    "vanilla/*.ts",
    "directives/**/*.ts",
    "directives/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
