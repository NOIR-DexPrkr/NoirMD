{
  "name": "@noirmd/previewer",
  "version": "1.0.0",
  "description": "Custom markdown parser and React renderer with directives, cards, modals, and Tailwind styling",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./editor": {
      "import": {
        "types": "./dist/NReditor.d.mts",
        "default": "./dist/NReditor.mjs"
      },
      "require": {
        "types": "./dist/NReditor.d.ts",
        "default": "./dist/NReditor.js"
      }
    },
    "./markdown.css": "./markdown.css"
  },
  "files": [
    "dist",
    "markdown.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "markdown",
    "react",
    "renderer",
    "preview",
    "editor",
    "directives",
    "tailwind",
    "admonitions",
    "cards"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@base-ui/react": ">=1.0.0",
    "@codemirror/language": ">=6.0.0",
    "@codemirror/state": ">=6.0.0",
    "@codemirror/view": ">=6.0.0",
    "@lezer/highlight": ">=1.0.0",
    "@uiw/react-codemirror": ">=4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "@uiw/react-codemirror": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    }
  },
  "dependencies": {
    "highlight.js": "^11.0.0"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^26.1.1",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@uiw/react-codemirror": "^4.25.11",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
