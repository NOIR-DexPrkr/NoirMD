{
  "name": "@noirmd/previewer",
  "version": "1.1.1",
  "type": "module",
  "description": "Framework-agnostic markdown parser with React renderer, directives, cards, modals, and Tailwind styling",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs",
      "default": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs",
      "default": "./dist/react.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js",
      "require": "./dist/vanilla.cjs",
      "default": "./dist/vanilla.js"
    },
    "./vanilla/vanilla.css": "./dist/vanilla.css",
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs",
      "default": "./dist/vue.js"
    },
    "./editor": {
      "types": "./dist/NReditor.d.ts",
      "import": "./dist/NReditor.js",
      "require": "./dist/NReditor.cjs",
      "default": "./dist/NReditor.js"
    },
    "./markdown.css": "./markdown.css"
  },
  "files": [
    "dist",
    "markdown.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "markdown",
    "react",
    "renderer",
    "preview",
    "editor",
    "directives",
    "tailwind",
    "admonitions",
    "cards",
    "vue"
  ],
  "author": "NOIR-DexPrkr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NOIR-DexPrkr/NoirMD.git",
    "directory": "markdown-v2"
  },
  "homepage": "https://github.com/NOIR-DexPrkr/NoirMD#readme",
  "bugs": {
    "url": "https://github.com/NOIR-DexPrkr/NoirMD/issues"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.0.0",
    "@codemirror/language": ">=6.0.0",
    "@codemirror/state": ">=6.0.0",
    "@codemirror/view": ">=6.0.0",
    "@lezer/highlight": ">=1.0.0",
    "@uiw/react-codemirror": ">=4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@uiw/react-codemirror": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    }
  },
  "dependencies": {
    "highlight.js": "^11.0.0"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^26.1.1",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@uiw/react-codemirror": "^4.25.11",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vue": "^3.5.40"
  }
}
