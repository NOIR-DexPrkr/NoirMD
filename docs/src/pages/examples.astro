---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import InteractivePreview from '../components/InteractivePreview.astro';

const examples = [
  {
    title: 'Admonitions',
    markdown: `:::note {title="Note"}
This is a note admonition with a title.
:::

:::warning {title="Warning"}
Be careful with this operation.
:::

:::danger {title="Danger"}
This action is irreversible!
:::`,
  },
  {
    title: 'Cards',
    markdown: `:::card {title="Card Title" icon="star"}
#description
A short description of the card.
#content
Main content goes here.
:::`,
  },
  {
    title: 'Details',
    markdown: `:::details {title="Click to expand" icon="expand_more"}
Hidden content that can be toggled.
:::`,
  },
  {
    title: 'Button',
    markdown: `:::button {url="https://github.com" label="Visit GitHub" icon="open_in_new"}
:::`,
  },
  {
    title: 'Code Block',
    markdown: '```typescript\nconst greeting = "Hello, NoirMD!";\nconsole.log(greeting);\n```',
  },
  {
    title: 'Table',
    markdown: `| Feature | React | Vue | Vanilla |
|---------|-------|-----|---------|
| SSR | Yes | Yes | N/A |
| Tree Shaking | Yes | Yes | Yes |
| TypeScript | Full | Full | Full |`,
  },
];
---

<Layout title="Examples">
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-2">Examples</h1>
      <p class="text-[var(--color-text-secondary)]">
        See NoirMD in action with different markdown features and directives.
      </p>
    </div>

    <div class="space-y-12">
      {examples.map(example => (
        <InteractivePreview markdown={example.markdown} title={example.title} />
      ))}
    </div>
  </main>
</Layout>
