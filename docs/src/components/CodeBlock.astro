---
interface Props {
  code: string;
  language?: string;
  title?: string;
}

const { code, language = 'markdown', title } = Astro.props;
---

<div class="my-4 rounded-2xl border border-[var(--color-border)] overflow-hidden bg-[var(--color-background-secondary)]/50">
  {title && (
    <div class="flex items-center gap-2 px-4 py-2 border-b border-[var(--color-border)] bg-[var(--color-background-secondary)]/50 text-xs font-mono text-[var(--color-text-secondary)]">
      <span class="material-symbols-rounded text-base">description</span>
      {title}
    </div>
  )}
  <pre class="p-4 overflow-x-auto text-sm"><code class={`language-${language}`}>{code}</code></pre>
</div>
