---
interface Props {
  content: string;
}

const { content } = Astro.props;

// Extract headings (## and ###) for TOC
const headings: { depth: number; text: string; slug: string }[] = [];
const lines = content.split('\n');

for (const line of lines) {
  const match = line.match(/^(#{2,3})\s+(.+)/);
  if (match) {
    const depth = match[1].length;
    const text = match[2].replace(/`/g, '').trim();
    const slug = text
      .toLowerCase()
      .replace(/[^\w\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-');
    headings.push({ depth, text, slug });
  }
}
---

{headings.length > 0 && (
  <nav class="hidden xl:block w-56 shrink-0">
    <div class="sticky top-24">
      <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--color-text-secondary)] mb-3">
        On this page
      </h4>
      <ul class="space-y-1 border-l border-[var(--color-border)]">
        {headings.map(h => (
          <li>
            <a
              href={`#${h.slug}`}
              class={`block text-sm no-underline transition-colors hover:text-[var(--color-accent-primary)] ${
                h.depth === 3 ? 'pl-6' : 'pl-3'
              } text-[var(--color-text-secondary)]`}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}
