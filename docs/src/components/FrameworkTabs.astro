---
interface Props {
  markdown: string;
  title?: string;
}

const { markdown, title } = Astro.props;
---

<div class="my-8" data-markdown={markdown}>
  {title && (
    <h3 class="text-lg font-bold mb-4 text-[var(--color-text-primary)]">{title}</h3>
  )}

  <!-- Code display -->
  <div class="mb-4 rounded-2xl border border-[var(--color-border)] overflow-hidden bg-[var(--color-background-secondary)]/50">
    <div class="flex items-center gap-2 px-4 py-2 border-b border-[var(--color-border)] bg-[var(--color-background-secondary)]/50 text-xs font-mono text-[var(--color-text-secondary)]">
      <span class="material-symbols-rounded text-base">code</span>
      Markdown Source
    </div>
    <pre class="p-4 overflow-x-auto text-sm"><code class="language-markdown">{markdown}</code></pre>
  </div>

  <!-- Framework tabs -->
  <div class="framework-tabs">
    <div class="flex gap-1 mb-4 border-b border-[var(--color-border)]">
      <button class="framework-tab active px-4 py-2 text-sm font-medium border-b-2 border-[var(--color-accent-primary)] text-[var(--color-accent-primary)]" data-framework="react">
        React
      </button>
      <button class="framework-tab px-4 py-2 text-sm font-medium border-b-2 border-transparent text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]" data-framework="vue">
        Vue
      </button>
      <button class="framework-tab px-4 py-2 text-sm font-medium border-b-2 border-transparent text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]" data-framework="vanilla">
        Vanilla
      </button>
    </div>

    <!-- React preview -->
    <div class="framework-preview" data-framework="react">
      <div class="react-preview-container rounded-2xl border border-[var(--color-border)] p-6 bg-[var(--color-background-primary)]">
        <div class="flex items-center gap-2 mb-4 text-xs text-[var(--color-text-secondary)]">
          <span class="material-symbols-rounded text-base">play_arrow</span>
          React Preview
        </div>
        <div class="nr-prose react-preview" data-content={markdown}></div>
      </div>
    </div>

    <!-- Vue preview -->
    <div class="framework-preview hidden" data-framework="vue">
      <div class="rounded-2xl border border-[var(--color-border)] p-6 bg-[var(--color-background-primary)]">
        <div class="flex items-center gap-2 mb-4 text-xs text-[var(--color-text-secondary)]">
          <span class="material-symbols-rounded text-base">play_arrow</span>
          Vue Preview
        </div>
        <div class="nr-prose vue-preview" data-content={markdown}></div>
      </div>
    </div>

    <!-- Vanilla preview -->
    <div class="framework-preview hidden" data-framework="vanilla">
      <div class="rounded-2xl border border-[var(--color-border)] p-6 bg-[var(--color-background-primary)]">
        <div class="flex items-center gap-2 mb-4 text-xs text-[var(--color-text-secondary)]">
          <span class="material-symbols-rounded text-base">play_arrow</span>
          Vanilla Preview
        </div>
        <div class="nr-prose vanilla-preview" data-content={markdown}></div>
      </div>
    </div>
  </div>
</div>

<script>
  // Tab switching
  document.querySelectorAll('.framework-tabs').forEach(tabsContainer => {
    const tabs = tabsContainer.querySelectorAll('.framework-tab');
    const previews = tabsContainer.querySelectorAll('.framework-preview');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const framework = tab.getAttribute('data-framework');

        // Update active tab
        tabs.forEach(t => {
          t.classList.remove('active', 'border-[var(--color-accent-primary)]', 'text-[var(--color-accent-primary)]');
          t.classList.add('border-transparent', 'text-[var(--color-text-secondary)]');
        });
        tab.classList.add('active', 'border-[var(--color-accent-primary)]', 'text-[var(--color-accent-primary)]');
        tab.classList.remove('border-transparent', 'text-[var(--color-text-secondary)]');

        // Show/hide previews
        previews.forEach(p => {
          if (p.getAttribute('data-framework') === framework) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });
  });
</script>
